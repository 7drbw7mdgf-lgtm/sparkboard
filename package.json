{
  "name": "sparkboard",
  "version": "1.3.2",
  "private": true,
  "description": "A local-first visual whiteboard inspired by Lucidspark",
  "scripts": {
    "start": "node server.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test board-model.test.cjs updater.test.cjs tests/*.test.js tests/*.test.cjs",
    "sandbox:prepare": "node scripts/release.cjs --sandbox",
    "release:build": "node scripts/release.cjs",
    "release:keygen": "node scripts/release.cjs --keygen",
    "build": "node scripts/build.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mac": "python3 scripts/build-macos.py"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
